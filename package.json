{
  "name": "html-render-mcp",
  "version": "0.3.2",
  "description": "A local MCP server that renders structured page data into Cherry Studio HTML fragments and stable HTML files.",
  "type": "module",
  "bin": {
    "html-render-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --test --import tsx src/test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "html",
    "renderer",
    "cherry-studio"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
