{
  "name": "html-render-mcp",
  "version": "0.3.0",
  "description": "A local MCP server that renders structured page data into Cherry Studio HTML fragments and stable HTML files.",
  "type": "module",
  "bin": {
    "html-render-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "html",
    "renderer",
    "cherry-studio"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "prettier": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
